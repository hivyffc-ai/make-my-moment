---
import { siteConfig, cities, services } from '../lib/config';
const year = new Date().getFullYear();
---
<footer class="bg-stone-900 text-stone-300 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 bg-gradient-to-br from-primary to-rose-700 rounded-lg flex items-center justify-center">
            <span class="text-white text-sm font-bold">B</span>
          </div>
          <span class="font-serif font-bold text-white text-base">BookMyMoment<span class="text-rose-400">.in</span></span>
        </div>
        <p class="text-xs text-stone-500 font-semibold uppercase tracking-widest mb-3">India's Premium Celebration Platform</p>
        <p class="text-sm leading-relaxed mb-4 text-stone-400">
          Private romantic celebrations across India — candlelight dinners, birthday surprises, proposals & anniversaries in exclusive venues.
        </p>
        <a href={`tel:${siteConfig.phone}`} class="text-xs text-rose-400 hover:text-rose-300">📞 {siteConfig.phone}</a>
      </div>

      <!-- Cities -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Our Cities</h3>
        <ul class="space-y-3">
          {cities.map(city => (
            <li>
              <a href={`/${city.slug}/`} class="text-sm text-stone-400 hover:text-rose-400 transition-colors block">
                <span class="text-base mr-2">{city.emoji}</span>
                <span class="font-medium text-stone-200">{city.name}</span>
                <span class="text-stone-500 text-xs block ml-6">{city.venue}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Celebration Types</h3>
        <ul class="space-y-2">
          {services.map(s => (
            <li class="text-sm text-stone-400 flex items-center gap-2">
              <span>{s.icon}</span> {s.name}
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-xs text-stone-400 hover:text-rose-400">Home</a></li>
          <li><a href="/vadodara/" class="text-xs text-stone-400 hover:text-rose-400">Vadodara — Friends Factory Cafe</a></li>
          <li><a href="/surat/" class="text-xs text-stone-400 hover:text-rose-400">Surat — HIVY</a></li>
          <li><a href="/about/" class="text-xs text-stone-400 hover:text-rose-400">About Us</a></li>
          <li><a href="/contact/" class="text-xs text-stone-400 hover:text-rose-400">Contact</a></li>
        </ul>
        <div class="mt-5 pt-5 border-t border-stone-800">
          <a
            href={`https://wa.me/${siteConfig.whatsapp}?text=Hi%2C%20I%20want%20to%20book%20a%20celebration%20via%20BookMyMoment`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25D366] text-white text-xs font-semibold px-4 py-2.5 rounded-lg hover:bg-green-500 transition-colors"
          >
            <svg viewBox="0 0 24 24" class="w-4 h-4 fill-white flex-shrink-0">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Book on WhatsApp
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-stone-800 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-stone-500">© {year} BookMyMoment.in. All rights reserved.</p>
      <p class="text-xs text-stone-500">Made with ❤️ in Gujarat, India</p>
    </div>
  </div>
</footer>
