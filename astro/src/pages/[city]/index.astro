---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { cities } from '../../lib/config';

export async function getStaticPaths() {
  return cities.map(city => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const canonical = `https://bookmymoment.in/${city.slug}/`;

// Pre-compute formatted prices
const minPriceFmt = city.minPrice.toLocaleString('en-IN');
const pkgPrices: Record<string, string> = {};
city.packages.forEach(pkg => { pkgPrices[pkg.slug] = pkg.price.toLocaleString('en-IN'); });

// Pre-compute middle index (for "Most Popular" badge and highlight styles)
const midIdx = Math.floor(city.packages.length / 2);

// Pre-compute all per-package render data to keep JSX attributes simple
interface PkgRenderData {
  slug: string; name: string; price: number; description: string; emoji: string; features: string[];
  priceFmt: string; waUrl: string; isMid: boolean;
  cardClass: string; titleClass: string; priceClass: string; descClass: string;
  liClass: string; checkClass: string; btnClass: string;
}

const pkgData: PkgRenderData[] = city.packages.map((pkg, idx) => {
  const isMid = idx === midIdx;
  return {
    ...pkg,
    priceFmt: pkgPrices[pkg.slug],
    waUrl: `https://wa.me/${city.whatsapp}?text=Hi%20${encodeURIComponent(city.venue)}%2C%20I%27m%20interested%20in%20the%20${encodeURIComponent(pkg.name)}%20package%20(%E2%82%B9${pkgPrices[pkg.slug]})`,
    isMid,
    cardClass: isMid ? 'bg-gradient-to-br from-rose-600 to-rose-800 shadow-xl shadow-rose-200' : 'glass border border-stone-100',
    titleClass: isMid ? 'text-white' : 'text-stone-900',
    priceClass: isMid ? 'text-amber-300' : 'gradient-text',
    descClass: isMid ? 'text-white/80' : 'text-stone-500',
    liClass: isMid ? 'text-white/90' : 'text-stone-600',
    checkClass: isMid ? 'text-amber-300' : 'text-rose-500',
    btnClass: isMid ? 'bg-white text-rose-700 hover:bg-rose-50' : 'btn-primary',
  };
});

const faqs = [
  {
    q: `Where is ${city.venue} located?`,
    a: `${city.venue} is located at ${city.address}.`,
  },
  {
    q: `What is the starting price for celebrations in ${city.name}?`,
    a: `Celebrations at ${city.venue} start from ₹${minPriceFmt}. All packages include 3-hour private booking, decorations, cake, and music.`,
  },
  {
    q: `How do I book a celebration in ${city.name}?`,
    a: `WhatsApp ${city.venue} at ${city.phone} with your preferred date, occasion, and package choice. We confirm your slot instantly.`,
  },
  {
    q: `What services does ${city.venue} offer?`,
    a: `We offer ${city.services.slice(0, 5).join(', ')}, and more — all as 100% private exclusive experiences.`,
  },
  {
    q: `How many time slots are available for bookings?`,
    a: `We offer ${city.timeSlots.length} time slots: ${city.timeSlots.join(', ')}.`,
  },
];
---

<Layout
  title={`${city.venue} ${city.name} | Private Celebration Packages from ₹${minPriceFmt} | BookMyMoment`}
  description={`Book private celebrations at ${city.venue} in ${city.name}. ${city.packages.length} exclusive packages from ₹${minPriceFmt}. Candlelight dinners, birthday surprises, proposals & more. WhatsApp to book instantly.`}
  canonical={canonical}
  breadcrumbs={[
    { name: "Home", url: "https://bookmymoment.in" },
    { name: city.name, url: canonical },
  ]}
  faqs={faqs}
>
  <Header />
  <main class="pt-20">

    <!-- Hero -->
    <section class="py-16 sm:py-24 bg-gradient-to-br from-rose-50 via-white to-amber-50 overflow-hidden relative">
      <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 30% 50%, #e11d48 0%, transparent 60%), radial-gradient(circle at 70% 30%, #f59e0b 0%, transparent 60%)"></div>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-12">
          <div class="inline-flex items-center gap-2 bg-white border border-rose-100 text-rose-700 text-xs font-semibold px-4 py-1.5 rounded-full mb-5 shadow-sm">
            📍 {city.name}, {city.state}
          </div>
          <h1 class="font-serif text-4xl sm:text-5xl font-bold text-stone-900 mb-4">
            {city.venue}
          </h1>
          <p class="text-stone-500 text-lg max-w-2xl mx-auto mb-6 leading-relaxed">{city.tagline}</p>
          <div class="flex flex-wrap justify-center gap-3 mb-8">
            {city.highlights.map(h => (
              <span class="glass border border-stone-100 text-stone-700 text-sm px-4 py-1.5 rounded-full font-medium">{h}</span>
            ))}
          </div>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href={`https://wa.me/${city.whatsapp}?text=Hi%2C%20I%20want%20to%20book%20a%20celebration%20at%20${encodeURIComponent(city.venue)}%20in%20${encodeURIComponent(city.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold px-8 py-3.5 rounded-xl hover:bg-green-500 transition-colors"
            >
              <svg viewBox="0 0 24 24" class="w-5 h-5 fill-white flex-shrink-0">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Book on WhatsApp
            </a>
            <a href={`tel:${city.phone}`}
              class="inline-flex items-center justify-center gap-2 glass border border-stone-200 text-stone-800 font-semibold px-8 py-3.5 rounded-xl hover:border-rose-300 transition-colors">
              📞 {city.phone}
            </a>
          </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-4 max-w-lg mx-auto">
          {[
            { val: city.rating + '★', label: 'Google Rating' },
            { val: city.reviewCount, label: 'Reviews' },
            { val: city.couplesServed, label: 'Couples Served' },
          ].map(s => (
            <div class="glass rounded-xl p-4 text-center border border-stone-100">
              <div class="font-serif text-2xl font-bold gradient-text">{s.val}</div>
              <div class="text-xs text-stone-500 mt-1">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Packages -->
    <section class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mb-3">
            Our <span class="gradient-text">Packages</span>
          </h2>
          <p class="text-stone-500 max-w-xl mx-auto">
            {city.packages.length} exclusive setups in {city.name} — all-inclusive with 3-hour private venue, decorations & entertainment
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {pkgData.map(pkg => (
            <div class={`rounded-2xl overflow-hidden card-hover relative flex flex-col ${pkg.cardClass}`}>
              {pkg.isMid && (
                <div class="absolute top-3 right-3 bg-amber-400 text-stone-900 text-xs font-bold px-2.5 py-1 rounded-full">⭐ Most Popular</div>
              )}
              <div class="p-6 flex-1 flex flex-col">
                <div class="text-4xl mb-3">{pkg.emoji}</div>
                <h3 class={`font-serif text-lg font-bold mb-1 ${pkg.titleClass}`}>{pkg.name}</h3>
                <div class={`text-2xl font-bold mb-3 ${pkg.priceClass}`}>₹{pkg.priceFmt}</div>
                <p class={`text-xs leading-relaxed mb-4 flex-1 ${pkg.descClass}`}>{pkg.description}</p>
                <ul class="space-y-1 mb-5">
                  {pkg.features.map(f => (
                    <li class={`text-xs flex items-center gap-2 ${pkg.liClass}`}>
                      <span class={pkg.checkClass}>✓</span> {f}
                    </li>
                  ))}
                </ul>
                <a
                  href={pkg.waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`w-full text-center block py-3 px-4 rounded-xl text-sm font-semibold transition-all ${pkg.btnClass}`}
                >
                  Book This Package
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="py-16 bg-stone-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-serif text-3xl font-bold text-stone-900 text-center mb-10">Available Occasions</h2>
        <div class="flex flex-wrap justify-center gap-3">
          {city.services.map(s => (
            <span class="glass border border-stone-100 text-stone-700 text-sm px-4 py-2 rounded-full card-hover">
              {s}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Time Slots -->
    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-serif text-3xl font-bold text-stone-900 mb-8">Available Time Slots</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {city.timeSlots.map(slot => (
            <div class="glass rounded-xl p-4 border border-stone-100 card-hover">
              <div class="text-2xl mb-2">⏰</div>
              <p class="text-sm font-medium text-stone-800">{slot}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-stone-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-serif text-3xl font-bold text-stone-900 text-center mb-10">FAQs</h2>
        <div class="space-y-3" id="faq-accordion">
          {faqs.map(faq => (
            <div class="glass rounded-xl overflow-hidden border border-stone-100">
              <button class="faq-btn w-full text-left px-5 py-4 flex items-start justify-between gap-3 font-semibold text-stone-900 text-sm hover:text-primary transition-colors" aria-expanded="false">
                <span>{faq.q}</span>
                <span class="faq-icon text-lg text-primary flex-shrink-0">+</span>
              </button>
              <div class="faq-answer hidden px-5 pb-4">
                <p class="text-stone-600 text-sm leading-relaxed">{faq.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Location & CTA -->
    <section class="py-16 bg-gradient-to-br from-rose-600 to-rose-800 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
          <div>
            <h2 class="font-serif text-3xl font-bold mb-4">Visit Us in {city.name}</h2>
            <p class="text-rose-200 text-sm leading-relaxed mb-4">{city.address}</p>
            <a href={`tel:${city.phone}`} class="text-amber-300 font-semibold hover:text-amber-200">📞 {city.phone}</a>
          </div>
          <div class="flex flex-col gap-4">
            <a
              href={`https://wa.me/${city.whatsapp}?text=Hi%20${encodeURIComponent(city.venue)}%2C%20I%20want%20to%20book%20a%20celebration%20in%20${encodeURIComponent(city.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold px-8 py-4 rounded-xl hover:bg-green-500 transition-colors"
            >
              <svg viewBox="0 0 24 24" class="w-5 h-5 fill-white flex-shrink-0"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp to Book Now
            </a>
            <a href="/" class="text-center text-rose-200 text-sm hover:text-white transition-colors">← Back to all cities</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>

<script>
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;
      const isOpen = !answer.classList.contains('hidden');
      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => { (i as HTMLElement).textContent = '+'; });
      document.querySelectorAll('.faq-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));
      if (!isOpen) {
        answer.classList.remove('hidden');
        icon.textContent = '−';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
