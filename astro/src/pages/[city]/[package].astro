---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { cities } from '../../lib/config';

export async function getStaticPaths() {
  const paths = [];
  for (const city of cities) {
    for (const pkg of city.packages) {
      paths.push({
        params: { city: city.slug, package: pkg.slug },
        props: { city, pkg },
      });
    }
  }
  return paths;
}

const { city, pkg } = Astro.props;
const canonical = `https://bookmymoment.in/${city.slug}/${pkg.slug}/`;
const pkgPriceFmt = pkg.price.toLocaleString('en-IN');
---

<Layout
  title={`${pkg.name} in ${city.name} | ${city.venue} | ₹${pkgPriceFmt} | BookMyMoment`}
  description={`Book ${pkg.name} at ${city.venue} in ${city.name} for ₹${pkgPriceFmt}. ${pkg.description}. 100% private 3-hour setup with decorations, music & more. WhatsApp to book instantly.`}
  canonical={canonical}
  breadcrumbs={[
    { name: "Home", url: "https://bookmymoment.in" },
    { name: city.name, url: `https://bookmymoment.in/${city.slug}/` },
    { name: pkg.name, url: canonical },
  ]}
  faqs={[
    { q: `What is included in the ${pkg.name} package?`, a: `The ${pkg.name} package includes: ${pkg.features.join(', ')}. All at ${city.venue} in ${city.name}.` },
    { q: `How much does ${pkg.name} cost?`, a: `The ${pkg.name} package is priced at ₹${pkgPriceFmt} for a 3-hour private booking at ${city.venue}.` },
    { q: `How do I book the ${pkg.name} package?`, a: `WhatsApp ${city.venue} at ${city.phone} mentioning the ${pkg.name} package and your preferred date. We confirm instantly.` },
    { q: `Is the venue completely private for this setup?`, a: `Yes! Your entire booking is 100% private — exclusively yours with no other guests during your celebration.` },
  ]}
>
  <Header />
  <main class="pt-20">

    <!-- Hero -->
    <section class="py-20 bg-gradient-to-br from-rose-50 via-white to-amber-50 relative overflow-hidden">
      <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 30% 50%, #e11d48 0%, transparent 60%)"></div>
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <!-- Breadcrumb -->
            <nav class="flex items-center gap-2 text-xs text-stone-400 mb-5" aria-label="Breadcrumb">
              <a href="/" class="hover:text-primary">Home</a>
              <span>/</span>
              <a href={`/${city.slug}/`} class="hover:text-primary">{city.name}</a>
              <span>/</span>
              <span class="text-stone-600">{pkg.name}</span>
            </nav>

            <div class="text-5xl mb-4">{pkg.emoji}</div>
            <h1 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mb-3">{pkg.name}</h1>
            <p class="text-stone-500 text-sm mb-2">
              at <a href={`/${city.slug}/`} class="text-primary font-medium hover:underline">{city.venue}</a>, {city.name}
            </p>
            <div class="text-3xl font-bold gradient-text mb-5">₹{pkgPriceFmt}</div>
            <p class="text-stone-600 leading-relaxed mb-6">{pkg.description}</p>

            <ul class="space-y-2 mb-8">
              {pkg.features.map(f => (
                <li class="flex items-center gap-2 text-sm text-stone-700">
                  <span class="w-5 h-5 bg-rose-100 text-rose-600 rounded-full flex items-center justify-center text-xs flex-shrink-0">✓</span>
                  {f}
                </li>
              ))}
            </ul>

            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href={`https://wa.me/${city.whatsapp}?text=Hi%20${encodeURIComponent(city.venue)}%2C%20I%27m%20interested%20in%20the%20${encodeURIComponent(pkg.name)}%20package%20(%E2%82%B9${pkgPriceFmt})%20in%20${encodeURIComponent(city.name)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold px-7 py-3.5 rounded-xl hover:bg-green-500 transition-colors"
              >
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-white flex-shrink-0"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Book on WhatsApp
              </a>
              <a href={`tel:${city.phone}`}
                class="inline-flex items-center justify-center gap-2 glass border border-stone-200 text-stone-800 font-semibold px-7 py-3.5 rounded-xl hover:border-rose-300 transition-colors">
                📞 Call to Book
              </a>
            </div>
            <p class="text-stone-400 text-xs mt-3">⚡ Instant reply · No advance payment required</p>
          </div>

          <!-- Package visual -->
          <div class="flex justify-center">
            <div class="glass rounded-3xl p-10 text-center border border-stone-100 card-hover max-w-xs w-full">
              <div class="text-8xl mb-6">{pkg.emoji}</div>
              <h2 class="font-serif text-xl font-bold text-stone-900 mb-2">{pkg.name}</h2>
              <div class="text-2xl font-bold gradient-text mb-4">₹{pkgPriceFmt}</div>
              <div class="text-xs text-stone-400 bg-stone-50 rounded-lg px-3 py-2 mb-4">3-Hour Private Booking</div>
              <div class="flex items-center justify-center gap-1 text-xs text-stone-500">
                <span>⭐</span> {city.rating} · {city.reviewCount} reviews
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Other Packages -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-serif text-2xl font-bold text-stone-900 text-center mb-8">
          Other Packages at {city.venue}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {city.packages.filter(p => p.slug !== pkg.slug).slice(0, 3).map(other => (
            <a href={`/${city.slug}/${other.slug}/`} class="glass rounded-2xl p-5 card-hover border border-stone-100 flex items-center gap-4">
              <div class="text-3xl flex-shrink-0">{other.emoji}</div>
              <div>
                <h3 class="font-semibold text-stone-900 text-sm">{other.name}</h3>
                <div class="text-primary font-bold text-sm">₹{other.price.toLocaleString('en-IN')}</div>
              </div>
            </a>
          ))}
        </div>
        <div class="text-center mt-6">
          <a href={`/${city.slug}/`} class="text-primary font-semibold text-sm hover:underline">View all {city.packages.length} packages →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>
