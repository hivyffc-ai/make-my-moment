---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { siteConfig, cities } from '../lib/config';
---
<Layout
  title="Contact BookMyMoment.in | Book a Private Celebration in Vadodara or Surat"
  description="Contact BookMyMoment.in to book a private celebration. WhatsApp or call Friends Factory Cafe (Vadodara) at +91 7487888730 or HIVY (Surat) at +91 9727027278."
  canonical="https://bookmymoment.in/contact/"
  breadcrumbs={[{ name: "Home", url: "https://bookmymoment.in" }, { name: "Contact", url: "https://bookmymoment.in/contact/" }]}
>
  <Header />
  <main class="pt-24">
    <section class="py-16 bg-gradient-to-br from-stone-50 via-white to-rose-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h1 class="font-serif text-4xl sm:text-5xl font-bold text-stone-900 mb-4">
            Get in <span class="gradient-text">Touch</span>
          </h1>
          <p class="text-stone-500 text-lg max-w-xl mx-auto">
            Ready to book your celebration? Contact the venue in your city directly for the fastest response.
          </p>
        </div>

        <!-- Per-city contact cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          {cities.map(city => (
            <div class="glass rounded-2xl p-6 border border-stone-100">
              <div class="flex items-center gap-3 mb-5">
                <div class="text-3xl">{city.emoji}</div>
                <div>
                  <h2 class="font-serif text-xl font-bold text-stone-900">{city.name}</h2>
                  <p class="text-stone-400 text-xs">{city.venue}</p>
                </div>
              </div>

              <div class="space-y-3 mb-5">
                <div class="flex items-start gap-3">
                  <span class="text-lg mt-0.5">📍</span>
                  <p class="text-stone-600 text-sm leading-snug">{city.address}</p>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-lg">📞</span>
                  <a href={`tel:${city.phone}`} class="text-stone-700 text-sm font-medium hover:text-primary transition-colors">{city.phone}</a>
                </div>
              </div>

              <div class="flex flex-col gap-2.5">
                <a
                  href={`https://wa.me/${city.whatsapp}?text=Hi%20${encodeURIComponent(city.venue)}%2C%20I%20want%20to%20book%20a%20celebration`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white text-sm font-semibold px-5 py-3 rounded-xl hover:bg-green-500 transition-colors"
                >
                  <svg viewBox="0 0 24 24" class="w-4 h-4 fill-white flex-shrink-0"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  WhatsApp {city.name}
                </a>
                <a href={`/${city.slug}/`}
                  class="text-center text-primary text-sm font-medium hover:underline py-1">
                  View packages in {city.name} →
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- General enquiry -->
        <div class="glass rounded-2xl p-6 text-center border border-stone-100 max-w-md mx-auto">
          <h2 class="font-serif text-xl font-bold text-stone-900 mb-2">General Enquiries</h2>
          <p class="text-stone-500 text-sm mb-4">For partnerships, new cities, or other enquiries</p>
          <a href={`mailto:${siteConfig.email}`} class="text-primary font-semibold hover:underline">{siteConfig.email}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
